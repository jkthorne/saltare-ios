# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode — the project is generated from project.yml by XcodeGen; never commit it
*.xcodeproj
*.xcworkspace
# Info.plist + entitlements are generated by XcodeGen from project.yml
Saltare/Info.plist
SaltareWidgets/Info.plist
*.entitlements
xcuserdata/
DerivedData/
# CI builds into ./build via -derivedDataPath
build/
*.xcuserstate
*.xcscmblueprint

# macOS
.DS_Store

# Secrets — never commit API keys, signing material, or credentials
*.p8
*.p12
*.mobileprovision
secrets.xcconfig
